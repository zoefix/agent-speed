<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentSpeed.Presentation</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentSpeed.Core\AgentSpeed.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\spec\strings.json" Link="Localization\strings.json" LogicalName="AgentSpeed.Strings.Shared.json" />
    <EmbeddedResource Include="Localization\Strings.Windows.json" LogicalName="AgentSpeed.Strings.Windows.json" />
    <!-- DESIGN 4c: the hero vehicle art; spec/assets/vehicles.json stays the single source of truth. -->
    <EmbeddedResource Include="..\..\..\spec\assets\vehicles.json" Link="Hero\vehicles.json" LogicalName="AgentSpeed.Vehicles.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentSpeed.Presentation.Tests" />
  </ItemGroup>
</Project>
