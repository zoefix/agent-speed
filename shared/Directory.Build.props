<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- 0.0.0 marks a local development build (no automatic update checks); the publish scripts stamp the release version. -->
    <Version>0.0.0</Version>
    <Authors>zoefix</Authors>
    <Company>zoefix</Company>
    <Product>Agent Speed</Product>
    <Copyright>Copyright © 2026 zoefix</Copyright>
  </PropertyGroup>
</Project>
