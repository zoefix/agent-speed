<UserControl x:Class="AgentSpeed.Settings.BoardsPane.BoardsSection"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:remote="clr-namespace:AgentSpeed.Settings.Remote"
             xmlns:pane="clr-namespace:AgentSpeed.Settings.OrbsPane"
             xmlns:boards="clr-namespace:AgentSpeed.Settings.BoardsPane"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="BoardRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2,4,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                MinHeight="52" Padding="10,0,6,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource KeyboardFocusBorderColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleCard" TargetType="RadioButton">
            <Setter Property="Height" Value="112" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                            <Grid>
                                <Border x:Name="Tint" CornerRadius="7" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        Margin="-1" Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Tint" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource KeyboardFocusBorderColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Boards list (DESIGN 2c: under the orbs) -->
        <DockPanel Margin="2,30,2,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource CaptionText}" VerticalAlignment="Bottom"
                       Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="{loc:Loc boards.title}" Style="{StaticResource SectionHeaderText}" Margin="0" AutomationProperties.HeadingLevel="Level2" />
        </DockPanel>
        <Border Style="{StaticResource GroupBorder}">
            <StackPanel>
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource BoardRow}" Background="Transparent" BorderThickness="0" Padding="0,4,0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{loc:Loc boards.title}" PreviewKeyDown="OnListKeyDown"
                         Visibility="{Binding HasBoards, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type boards:BoardRowViewModel}">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <boards:BoardThumbnail Side="38" StyleKind="{Binding Style}" Readouts="{Binding Readouts}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Dark="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6,12,6">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2" Width="32" Height="32" IsChecked="{Binding IsShown, Mode=OneWay}" Focusable="False"
                                              Command="{Binding DataContext.ToggleVisibleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}" ToolTip="{loc:Loc win.boards.visible}"
                                              AutomationProperties.Name="{loc:Loc win.boards.visible}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <TextBlock x:Name="Eye" Style="{StaticResource SymbolIcon}" FontSize="14" Text="&#xE890;"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </ToggleButton>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsShown}" Value="False">
                                    <Setter TargetName="Eye" Property="Text" Value="&#xED1A;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Rectangle Style="{StaticResource Hairline}" Visibility="{Binding HasBoards, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="6,4,6,4">
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding AddCommand}" ToolTip="{Binding AddTooltip}"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc boards.add}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SymbolIcon}" FontSize="13" Text="&#xE710;" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc boards.add}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding RemoveCommand}" ToolTip="{loc:Loc boards.remove}"
                            AutomationProperties.Name="{loc:Loc boards.remove}" Margin="2,0,0,0"
                            Visibility="{Binding HasBoards, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SymbolIcon}" FontSize="14" Text="&#xE738;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Editor of the selected board -->
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" Margin="0,26,0,0">
            <TextBlock Text="{Binding EditorTitle}" FontSize="17" FontWeight="SemiBold" Margin="4,0,0,14"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.HeadingLevel="Level3" />

            <!-- Sources -->
            <TextBlock Text="{loc:Loc orbs.sources}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <Border Style="{StaticResource GroupBorder}" Padding="14,6,14,6">
                <StackPanel>
                    <CheckBox IsChecked="{Binding AllSources, Mode=TwoWay}" Margin="0,4,0,6" AutomationProperties.Name="{loc:Loc orbs.sources.all}">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{loc:Loc orbs.sources.all}" FontSize="13" />
                            <TextBlock Text="{loc:Loc orbs.sources.allHint}" Style="{StaticResource CaptionText}" FontSize="11" />
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Style="{StaticResource Hairline}" Margin="0,2,0,2" />
                    <ItemsControl ItemsSource="{Binding SourceRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pane:OrbSourceRowViewModel}">
                                <DockPanel Margin="0,3,0,3" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding IsEnabled}" Click="OnSourceClick"
                                              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Status}">
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <remote:HostPickerSection DataContext="{Binding HostPicker}" />

            <!-- Style -->
            <TextBlock Text="{loc:Loc boards.style}" Style="{StaticResource SectionHeaderText}" Margin="2,22,0,8" AutomationProperties.HeadingLevel="Level3" />
            <Border Style="{StaticResource GroupBorder}" Padding="14,14,6,6">
                <ItemsControl ItemsSource="{Binding StyleCards}" Focusable="False" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type boards:BoardStyleCardViewModel}">
                            <RadioButton Style="{StaticResource StyleCard}" GroupName="BoardStyle" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.SelectStyleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <boards:BoardThumbnail Side="64" StyleKind="{Binding Style}" HorizontalAlignment="Center" Margin="0,4,0,8"
                                                           Readouts="{Binding DataContext.Readouts, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           Dark="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Live metrics switches (DESIGN 2c, Live metrics: Switches) -->
            <TextBlock Text="{loc:Loc boards.readouts}" Style="{StaticResource SectionHeaderText}" Margin="2,22,0,8" AutomationProperties.HeadingLevel="Level3" />
            <Border Style="{StaticResource GroupBorder}" Padding="14,8,14,12">
                <StackPanel>
                    <UniformGrid Columns="3">
                        <CheckBox IsChecked="{Binding ReadoutIntelligence, Mode=TwoWay}" Margin="0,4,12,4" AutomationProperties.Name="{loc:Loc boards.readouts.intel}">
                            <TextBlock Text="{loc:Loc boards.readouts.intel}" FontSize="13" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ReadoutThinking, Mode=TwoWay}" Margin="0,4,12,4" AutomationProperties.Name="{loc:Loc boards.readouts.thinking}">
                            <TextBlock Text="{loc:Loc boards.readouts.thinking}" FontSize="13" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ReadoutCost, Mode=TwoWay}" Margin="0,4,0,4" AutomationProperties.Name="{loc:Loc boards.readouts.cost}">
                            <TextBlock Text="{loc:Loc boards.readouts.cost}" FontSize="13" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                    </UniformGrid>
                    <TextBlock Text="{loc:Loc boards.readouts.hint}" Style="{StaticResource CaptionText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Size and opacity -->
            <Border Style="{StaticResource GroupBorder}" Margin="0,16,0,0" Padding="16,4,16,4">
                <StackPanel>
                    <DockPanel MinHeight="48">
                        <TextBlock Text="{loc:Loc menu.size}" VerticalAlignment="Center" FontSize="13" />
                        <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                AutomationProperties.Name="{loc:Loc menu.size}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="BoardSize" Content="{loc:Loc menu.size.small}" IsChecked="{Binding SizeSmall, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="BoardSize" Content="{loc:Loc menu.size.medium}" IsChecked="{Binding SizeMedium, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="BoardSize" Content="{loc:Loc menu.size.large}" IsChecked="{Binding SizeLarge, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Hairline}" />
                    <DockPanel MinHeight="48">
                        <TextBlock Text="{loc:Loc settings.orb.opacity}" VerticalAlignment="Center" FontSize="13" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Slider Width="220" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                                    VerticalAlignment="Center" Value="{Binding OpacityPercent, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc settings.orb.opacity}" />
                            <TextBlock Text="{Binding OpacityText}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Window toggles -->
            <StackPanel Margin="0,16,0,0">
                <controls:SettingsCard Header="{loc:Loc menu.alwaysOnTop}" Icon="&#xE718;">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc menu.alwaysOnTop}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{loc:Loc menu.clickThrough}" Icon="&#xE7C9;" Description="{Binding ClickThroughHint}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickThrough, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc menu.clickThrough}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{loc:Loc settings.orb.fadeIdle}" Icon="&#xE708;" Description="{Binding FadeHint}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FadeWhenIdle, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc settings.orb.fadeIdle}" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
