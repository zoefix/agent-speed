<UserControl x:Class="AgentSpeed.Settings.Pages.ReportPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:reporting="clr-namespace:AgentSpeed.Reporting"
             xmlns:theme="clr-namespace:AgentSpeed.Theme"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <controls:TextToVisibilityConverter x:Key="HasText" />
        <controls:HelperDotBrushConverter x:Key="DotBrush" />
        <controls:EnabledOpacityConverter x:Key="EnabledOpacity" />

        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,14,16,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="DestructiveLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <!-- An amber note under a control: the caution symbol and a sentence that wraps beside it. -->
        <Style x:Key="CautionNote" TargetType="Grid">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- An inline message under a field: errors with the critical symbol, results with a check, both with text. -->
        <Style x:Key="InlineError" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 1. Master -->
        <controls:SettingsCard Header="{loc:Loc report.enabled}" Icon="&#xEC05;" Description="{Binding EnabledHint}" IsEnabled="{Binding NetworkEnabled}">
            <CheckBox x:Name="MasterSwitch" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                      AutomationProperties.Name="{loc:Loc report.enabled}" AutomationProperties.HelpText="{Binding EnabledHint}" />
        </controls:SettingsCard>
        <StackPanel Orientation="Horizontal" Margin="16,4,0,8" Visibility="{Binding ForgetDone, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE930;" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            <TextBlock Text="{loc:Loc report.forget.done}" Style="{StaticResource Footnote}" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- 2. Service -->
        <Border Style="{StaticResource GroupCard}" Margin="0,16,0,4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc report.service}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="240" SelectedIndex="{Binding ServiceIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Loc report.service}">
                        <ComboBoxItem Content="{Binding PresetName}" />
                        <ComboBoxItem IsEnabled="False" Focusable="False" IsHitTestVisible="False" Padding="0" MinHeight="0" Height="9"
                                      AutomationProperties.Name=" ">
                            <Separator Margin="0" />
                        </ComboBoxItem>
                        <ComboBoxItem Content="{loc:Loc report.service.custom}" />
                    </ComboBox>
                </Grid>

                <!-- The custom URL, validated as the user types and committed on Return or leaving the field -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCustom, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc report.url}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Width="320">
                            <TextBox x:Name="UrlBox" Text="{Binding CustomUrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnUrlKeyDown" LostKeyboardFocus="OnUrlLostFocus" MaxLength="2048"
                                     AutomationProperties.Name="{loc:Loc report.url}" />
                            <TextBlock Text="{loc:Loc report.url.placeholder}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <StackPanel Style="{StaticResource InlineError}" HorizontalAlignment="Right"
                                Visibility="{Binding UrlMessage, Converter={StaticResource HasText}}">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEA39;" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{Binding UrlMessage}" Style="{StaticResource Footnote}" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource InlineError}" HorizontalAlignment="Right"
                                Visibility="{Binding UrlLoopback, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{loc:Loc report.url.loopback}" Style="{StaticResource Footnote}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Rectangle Style="{StaticResource Hairline}" Margin="-16,14,-16,14" />

                <!-- The service card: what the app knows, then the fetched document's details -->
                <Grid x:Name="ServiceCard">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:AccentBadge Width="36" Height="36" CornerRadius="9" VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEC05;" FontSize="17" Foreground="White" />
                    </controls:AccentBadge>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding CardName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding HasCardName, Converter={StaticResource Visible}}" />
                        <TextBox Text="{Binding CardHost, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="-2,2,0,0"
                                 AutomationProperties.Name="{Binding CardHost}" />
                        <TextBox Text="{Binding CardServiceHost, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="-2,0,0,0"
                                 Visibility="{Binding CardServiceHost, Converter={StaticResource HasText}}" />
                        <StackPanel x:Name="CardDetails" Visibility="{Binding HasCard, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding CardDescription}" Style="{StaticResource Footnote}" Margin="0,6,0,0" MaxHeight="51"
                                       TextTrimming="CharacterEllipsis" Visibility="{Binding CardDescription, Converter={StaticResource HasText}}" />
                            <TextBlock Text="{Binding CardRetention}" Style="{StaticResource Footnote}" Margin="0,4,0,0"
                                       Visibility="{Binding CardRetention, Converter={StaticResource HasText}}" />
                            <WrapPanel Margin="-4,6,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.service.terms}" Command="{Binding TermsCommand}" FontSize="13" />
                                <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.service.privacy}" Command="{Binding PrivacyCommand}"
                                        FontSize="13" Margin="8,0,0,0" />
                                <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.service.leaderboard}" Command="{Binding LeaderboardCommand}"
                                        FontSize="13" Margin="8,0,0,0" Visibility="{Binding HasLeaderboard, Converter={StaticResource Visible}}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- While fetching, a failed fetch, a change that needs consent -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsChecking, Converter={StaticResource Visible}}">
                            <controls:ProgressRing Width="14" Height="14" Thickness="2" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{loc:Loc report.service.checking}" Style="{StaticResource Footnote}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0" Visibility="{Binding ServiceIssueText, Converter={StaticResource HasText}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IssueSymbol" FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceIssueIsPermanent}" Value="True">
                                                <Setter Property="Text" Value="&#xEA39;" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding ServiceIssueText}" Style="{StaticResource Footnote}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            <Button Grid.Column="2" Content="{loc:Loc report.service.retry}" Command="{Binding RetryCommand}" Margin="12,0,0,0"
                                    MinWidth="96" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0" Visibility="{Binding NeedsReview, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE946;" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc report.service.changed}" Style="{StaticResource Footnote}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Button Grid.Column="2" Content="{loc:Loc report.service.review}" Command="{Binding ReviewCommand}" Margin="12,0,0,0" MinWidth="96" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 2b. Transport: WebSocket by default (HTTP while the service lacks it); HTTP by the user's choice -->
                <StackPanel Visibility="{Binding ShowsTransport, Converter={StaticResource Visible}}">
                    <Rectangle Style="{StaticResource Hairline}" Margin="-16,14,-16,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TransportLabel" Text="{loc:Loc report.transport}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="ReportTransport" MinWidth="76"
                                             Content="{loc:Loc report.transport.http}" IsChecked="{Binding TransportHttp, Mode=TwoWay}"
                                             AutomationProperties.Name="{loc:Loc report.transport.http}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=TransportLabel}"
                                             AutomationProperties.HelpText="{Binding TransportHelpText}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="ReportTransport" MinWidth="76"
                                             IsChecked="{Binding TransportWebSocket, Mode=TwoWay}"
                                             AutomationProperties.Name="{loc:Loc report.transport.websocket}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=TransportLabel}"
                                             AutomationProperties.HelpText="{Binding TransportHelpText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE945;" FontSize="11" Margin="0,1,5,0" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <TextBlock Text="{loc:Loc report.transport.websocket}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TransportCaption}" Style="{StaticResource Footnote}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding TransportCaption, Converter={StaticResource HasText}}" />
                    <!-- WebSocket chosen, the service lacks it: a quiet note in the caption's place, since reports go over HTTP meanwhile -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding TransportUnsupportedText, Converter={StaticResource HasText}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE946;" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding TransportUnsupportedText}" Style="{StaticResource Footnote}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <Grid Style="{StaticResource CautionNote}" Visibility="{Binding TransportThrottledText, Converter={StaticResource HasText}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE7BA;" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding TransportThrottledText}" Style="{StaticResource Footnote}" TextWrapping="Wrap"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Profile, or the registration name while profile extensions are unavailable. -->
        <reporting:ReportProfileCard x:Name="InlineProfileCard" DataContext="{Binding Profile}"
                                    ManageDevicesCommand="{Binding DataContext.ManageDevicesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding DataContext.ShowsInlineProfile, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
        <Border Style="{StaticResource GroupCard}" Visibility="{Binding ShowsLegacyUsername, Converter={StaticResource Visible}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc report.username}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{loc:Loc report.username.public}" Style="{StaticResource Footnote}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="UsernameBox" Width="240" Text="{Binding UsernameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="64" KeyDown="OnUsernameKeyDown" GotKeyboardFocus="OnUsernameGotFocus" LostKeyboardFocus="OnUsernameLostFocus"
                                 AutomationProperties.Name="{loc:Loc report.username}" AutomationProperties.HelpText="{loc:Loc report.username.public}" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding RandomCommand}" Margin="4,0,0,0"
                                ToolTip="{loc:Loc report.username.random}" AutomationProperties.Name="{loc:Loc report.username.random}">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE8B1;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Style="{StaticResource InlineError}" HorizontalAlignment="Right" Visibility="{Binding HasUsernameMessage, Converter={StaticResource Visible}}">
                    <TextBlock FontSize="13" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
                                <Setter Property="Text" Value="&#xE930;" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsernameMessageIsError}" Value="True">
                                        <Setter Property="Text" Value="&#xEA39;" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding UsernameMessage}" Style="{StaticResource Footnote}" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding ShowsTransfer, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc report.username.transfer.hint}" Style="{StaticResource Footnote}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Content="{loc:Loc report.username.transfer}" Command="{Binding TransferCommand}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. API key (only for a known document that uses keys, once this device exists) -->
        <Border Style="{StaticResource GroupCard}" Visibility="{Binding ShowsApiKey, Converter={StaticResource Visible}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc report.apiKey}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{loc:Loc report.apiKey.required}" Style="{StaticResource Footnote}" Margin="0,2,0,0"
                                   Visibility="{Binding ApiKeyRequired, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasSavedApiKey, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding MaskedApiKey}" FontFamily="{x:Static theme:AppFonts.Monospace}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{loc:Loc report.apiKey}" />
                        <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.apiKey.clear}" Command="{Binding ClearApiKeyCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="240" VerticalAlignment="Center" x:Name="ApiKeyEntry">
                        <PasswordBox x:Name="ApiKeyBox" KeyDown="OnApiKeyKeyDown" LostKeyboardFocus="OnApiKeyLostFocus" PasswordChanged="OnApiKeyChanged"
                                     MaxLength="256" AutomationProperties.Name="{loc:Loc report.apiKey}" />
                        <TextBlock x:Name="ApiKeyPlaceholder" Text="{Binding ApiKeyPlaceholder}" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" />
                    </Grid>
                </Grid>
                <StackPanel Style="{StaticResource InlineError}" HorizontalAlignment="Right" Visibility="{Binding ApiKeyRejected, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEA39;" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{loc:Loc report.status.apiKey}" Style="{StaticResource Footnote}" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc report.apiKey.hint}" Style="{StaticResource Footnote}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{loc:Loc report.apiKey.get}" Command="{Binding GetApiKeyCommand}"
                            Visibility="{Binding HasApiKeyUrl, Converter={StaticResource Visible}}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. What's sent -->
        <TextBlock Text="{loc:Loc report.sections}" Style="{StaticResource SectionHeaderText}" Margin="2,20,0,4" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Text="{loc:Loc report.sections.hint}" Style="{StaticResource Footnote}" Margin="2,0,0,8" />
        <Border Style="{StaticResource GroupCard}" Padding="0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,0,16,0" MinHeight="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,16,8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" Opacity="{Binding IsEnabled, Converter={StaticResource EnabledOpacity}}" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Footnote}" Margin="0,1,0,0"
                                               Visibility="{Binding Caption, Converter={StaticResource HasText}}" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Footnote}" Margin="0,1,0,0"
                                               Visibility="{Binding Hint, Converter={StaticResource HasText}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                          AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding HelpText}" />
                                <Rectangle Grid.ColumnSpan="2" Style="{StaticResource Hairline}" VerticalAlignment="Bottom" Margin="-16,0,-16,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="16,10,16,12">
                    <Button HorizontalAlignment="Left" Command="{Binding PreviewCommand}" AutomationProperties.Name="{loc:Loc report.preview}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE890;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Loc report.preview}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 6. Status -->
        <TextBlock Text="{loc:Loc report.status}" Style="{StaticResource SectionHeaderText}" Margin="2,20,0,8" AutomationProperties.HeadingLevel="Level2" />
        <Border Style="{StaticResource GroupCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="2,7,12,0" Fill="{Binding StatusDot, Converter={StaticResource DotBrush}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Style="{StaticResource BodyText}" Typography.NumeralAlignment="Tabular"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Footnote}" Margin="0,2,0,0"
                               Visibility="{Binding StatusDetail, Converter={StaticResource HasText}}" />
                    <!-- WebSocket: latency and delivery counts; every counter in the tooltip (also on keyboard focus) -->
                    <Grid x:Name="StreamStats" Margin="0,3,0,0" HorizontalAlignment="Left" Background="Transparent"
                          Focusable="True" FocusVisualStyle="{StaticResource RoundedFocusVisual}"
                          ToolTip="{Binding StreamCountersText}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="20000"
                          AutomationProperties.Name="{Binding StreamStatsText}" AutomationProperties.HelpText="{Binding StreamCountersText}"
                          Visibility="{Binding StreamStatsText, Converter={StaticResource HasText}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StreamStatsText}" Style="{StaticResource Footnote}" Typography.NumeralAlignment="Tabular"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SymbolIcon}" Text="&#xE946;" FontSize="11" Margin="6,3,0,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding RankText}" Style="{StaticResource Footnote}" Margin="0,2,0,0"
                               Visibility="{Binding RankText, Converter={StaticResource HasText}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseButton" Click="OnPause" MinWidth="120" Visibility="{Binding ShowsPause, Converter={StaticResource Visible}}"
                            AutomationProperties.Name="{loc:Loc report.pause}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc report.pause}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc report.pause.hour}" Command="{Binding PauseHourCommand}" />
                                <MenuItem Header="{loc:Loc report.pause.indefinite}" Command="{Binding PauseIndefiniteCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="{loc:Loc report.resume}" Command="{Binding ResumeCommand}" MinWidth="120" Style="{DynamicResource AccentButtonStyle}"
                            Visibility="{Binding ShowsResume, Converter={StaticResource Visible}}" />
                    <Button Content="{loc:Loc report.service.retry}" Command="{Binding RetryCommand}" MinWidth="96" Margin="8,0,0,0"
                            Visibility="{Binding ShowsStatusRetry, Converter={StaticResource Visible}}" />
                    <Button Content="{loc:Loc report.service.retry}" Command="{Binding StreamRetryCommand}" MinWidth="96" Margin="8,0,0,0"
                            AutomationProperties.HelpText="{Binding StatusText}"
                            Visibility="{Binding ShowsStreamRetry, Converter={StaticResource Visible}}" />
                    <Button Content="{loc:Loc report.service.review}" Command="{Binding ReviewCommand}" MinWidth="96" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" Visibility="{Binding ShowsStatusReview, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 7. This device -->
        <StackPanel Visibility="{Binding ShowsDevice, Converter={StaticResource Visible}}">
            <TextBlock Text="{loc:Loc report.device}" Style="{StaticResource SectionHeaderText}" Margin="2,20,0,8" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource GroupCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE7F8;" FontSize="20" Margin="2,0,18,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{Binding DeviceDetail}" Style="{StaticResource BodyText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{loc:Loc report.device.fingerprint}" Style="{StaticResource Footnote}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding FingerprintText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="6,0,0,0"
                                         FontFamily="{x:Static theme:AppFonts.Monospace}" FontSize="12" VerticalAlignment="Center"
                                         AutomationProperties.Name="{loc:Loc report.device.fingerprint}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.device.profile}" Command="{Binding ProfileCommand}" HorizontalAlignment="Right"
                                    Visibility="{Binding HasProfile, Converter={StaticResource Visible}}" />
                            <Button Style="{StaticResource DestructiveLinkButton}" Content="{loc:Loc report.forget}" Command="{Binding ForgetCommand}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="38,8,0,0" Visibility="{Binding ForgetWorking, Converter={StaticResource Visible}}">
                        <controls:ProgressRing Width="14" Height="14" Thickness="2" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    </StackPanel>
                    <Border Margin="38,10,0,0" Padding="12,10" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding ShowsForgetLocal, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ForgetFailedText}" Style="{StaticResource Footnote}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <TextBlock Text="{loc:Loc report.forget.localOnly.detail}" Style="{StaticResource Footnote}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="-4,6,0,0">
                                <Button Style="{StaticResource DestructiveLinkButton}" Content="{loc:Loc report.forget.localOnly}" Command="{Binding ForgetLocalCommand}" />
                                <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.service.privacy}" Command="{Binding PrivacyCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="38,10,0,0" Padding="12,10" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding ShowsReset, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc report.reset.detail}" Style="{StaticResource Footnote}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Content="{loc:Loc report.reset}" Command="{Binding ResetCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 8. Other services -->
        <Expander Margin="0,16,0,0" Visibility="{Binding HasOthers, Converter={StaticResource Visible}}" IsExpanded="False"
                  AutomationProperties.Name="{loc:Loc report.others}">
            <Expander.Header>
                <TextBlock Text="{loc:Loc report.others}" Style="{StaticResource BodyText}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Others}" Focusable="False" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GroupCard}" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Host}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{Binding Username}" Style="{StaticResource Footnote}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource DestructiveLinkButton}" Content="{loc:Loc report.forget}"
                                        Command="{Binding Forget}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </StackPanel>
</UserControl>
