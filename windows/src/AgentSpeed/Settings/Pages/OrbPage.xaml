<UserControl x:Class="AgentSpeed.Settings.Pages.OrbPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:remote="clr-namespace:AgentSpeed.Settings.Remote"
             xmlns:pane="clr-namespace:AgentSpeed.Settings.OrbsPane"
             xmlns:tt="clr-namespace:AgentSpeed.Settings.TitleThemes"
             xmlns:boards="clr-namespace:AgentSpeed.Settings.BoardsPane"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Card group: the Fluent card look shared by the list and the editor groups. -->
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="OrbRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2,4,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                MinHeight="52" Padding="10,0,6,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource KeyboardFocusBorderColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleCard" TargetType="RadioButton">
            <Setter Property="Height" Value="112" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                            <Grid>
                                <Border x:Name="Tint" CornerRadius="7" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        Margin="-1" Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Tint" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource KeyboardFocusBorderColorBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="680" HorizontalAlignment="Stretch" DataContext="{Binding Orbs}">
        <!-- 1. Master group -->
        <controls:SettingsCard Header="{loc:Loc settings.orb.show}" Icon="&#xEA3A;" Description="{Binding AllNote}">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOrbs, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc settings.orb.show}" />
        </controls:SettingsCard>
        <controls:SettingsCard Header="{loc:Loc orbs.names}" Icon="&#xE8EC;" Description="{Binding OrbNamesHint}">
            <ComboBox MinWidth="200" SelectedIndex="{Binding OrbNamesIndex, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc orbs.names}"
                      AutomationProperties.HelpText="{Binding OrbNamesHint}">
                <ComboBoxItem Content="{loc:Loc orbs.names.auto}" />
                <ComboBoxItem Content="{loc:Loc orbs.names.always}" />
                <ComboBoxItem Content="{loc:Loc orbs.names.never}" />
            </ComboBox>
        </controls:SettingsCard>

        <!-- Undo banner (split, merge, remove; 8 s) -->
        <Border Style="{StaticResource GroupBorder}" Margin="0,12,0,0" Padding="14,6,6,6"
                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:Loc orbs.undo}" Command="{Binding UndoCommand}" />
                <TextBlock Text="{Binding UndoText}" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
            </DockPanel>
        </Border>

        <!-- 2. Orb list -->
        <DockPanel Margin="2,22,2,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource CaptionText}" VerticalAlignment="Bottom"
                       Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="{loc:Loc settings.orb}" Style="{StaticResource SectionHeaderText}" Margin="0" AutomationProperties.HeadingLevel="Level2" />
        </DockPanel>
        <Border Style="{StaticResource GroupBorder}">
            <StackPanel>
                <ListBox x:Name="OrbList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource OrbRow}" Background="Transparent" BorderThickness="0" Padding="0,4,0,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AllowDrop="True" AutomationProperties.Name="{loc:Loc settings.orb}"
                         PreviewKeyDown="OnListKeyDown" PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         Drop="OnListDrop" MouseLeave="OnListMouseLeave">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type pane:OrbRowViewModel}">
                            <Grid MouseEnter="OnRowEnter" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <pane:OrbPreview Diameter="38" StyleKind="{Binding Definition.Style}" CharacterId="{Binding Definition.Character}"
                                                     Value="{Binding Live}" Tier="{Binding Tier}" Title="{Binding Title}"
                                                     Dark="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     ReduceMotion="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6,12,6">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ToggleButton Grid.Column="3" Width="32" Height="32" IsChecked="{Binding IsShown, Mode=OneWay}" Focusable="False"
                                              Click="OnEyeClick" ToolTip="{loc:Loc orbs.visible}" AutomationProperties.Name="{loc:Loc orbs.visible}"
                                              Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <TextBlock x:Name="Eye" Style="{StaticResource SymbolIcon}" FontSize="14" Text="&#xE890;"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </ToggleButton>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsShown}" Value="False">
                                    <Setter TargetName="Eye" Property="Text" Value="&#xED1A;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Rectangle Style="{StaticResource Hairline}" />
                <DockPanel Margin="6,4,6,4">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding AddCommand}" ToolTip="{Binding AddTooltip}"
                                ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc orbs.add}">
                            <TextBlock Style="{StaticResource SymbolIcon}" FontSize="14" Text="&#xE710;" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding RemoveCommand}" ToolTip="{loc:Loc orbs.remove}"
                                AutomationProperties.Name="{loc:Loc orbs.remove}">
                            <TextBlock Style="{StaticResource SymbolIcon}" FontSize="14" Text="&#xE738;" />
                        </Button>
                        <Rectangle Width="1" Height="16" Margin="6,0,6,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding DuplicateCommand}" ToolTip="{Binding AddTooltip}"
                                ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc orbs.duplicate}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SymbolIcon}" FontSize="13" Text="&#xE8C8;" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Loc orbs.duplicate}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource LinkButton}" Content="{loc:Loc orbs.split}" Command="{Binding SplitCommand}"
                                ToolTip="{Binding SplitTooltip}" ToolTipService.ShowOnDisabled="True" FontSize="12" Margin="0,0,8,0" />
                        <Button Style="{StaticResource LinkButton}" Content="{loc:Loc orbs.merge}" Command="{Binding MergeCommand}"
                                ToolTip="{Binding MergeTooltip}" ToolTipService.ShowOnDisabled="True" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 3. Editor of the selected orb -->
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" Margin="0,26,0,0">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
                <ItemsControl ItemsSource="{Binding EditorDots}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="8" Height="8" Fill="{Binding}" Margin="0,0,5,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EditorTitle}" FontSize="17" FontWeight="SemiBold" Margin="4,0,0,0"
                           AutomationProperties.HeadingLevel="Level2" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Sources -->
            <TextBlock Text="{loc:Loc orbs.sources}" Style="{StaticResource SectionHeaderText}" AutomationProperties.HeadingLevel="Level3" />
            <Border Style="{StaticResource GroupBorder}" Padding="14,6,14,6">
                <StackPanel>
                    <CheckBox IsChecked="{Binding AllSources, Mode=TwoWay}" Margin="0,4,0,6" AutomationProperties.Name="{loc:Loc orbs.sources.all}">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{loc:Loc orbs.sources.all}" FontSize="13" />
                            <TextBlock Text="{loc:Loc orbs.sources.allHint}" Style="{StaticResource CaptionText}" FontSize="11" />
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Style="{StaticResource Hairline}" Margin="0,2,0,2" />
                    <ItemsControl ItemsSource="{Binding SourceRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pane:OrbSourceRowViewModel}">
                                <DockPanel Margin="0,3,0,3" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding IsEnabled}" Click="OnSourceClick"
                                              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Status}">
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <remote:HostPickerSection DataContext="{Binding HostPicker}" />

            <!-- Style -->
            <TextBlock Text="{loc:Loc orbs.style}" Style="{StaticResource SectionHeaderText}" Margin="2,22,0,8" AutomationProperties.HeadingLevel="Level3" />
            <Border Style="{StaticResource GroupBorder}" Padding="14,14,6,8">
                <StackPanel>
                    <ItemsControl x:Name="StyleCards" ItemsSource="{Binding StyleCards}" Focusable="False" KeyboardNavigation.DirectionalNavigation="Cycle"
                                  SizeChanged="OnCardsSizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" Loaded="OnCardsPanelLoaded" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pane:OrbStyleCardViewModel}">
                                <RadioButton Style="{StaticResource StyleCard}" GroupName="OrbStyle" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectStyleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel>
                                        <pane:OrbPreview Diameter="64" Card="True" CardIndex="{Binding Index}" StyleKind="{Binding Style}"
                                                         CharacterId="{Binding DataContext.CardCharacter, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         HorizontalAlignment="Center" Margin="0,4,0,8"
                                                         Labels="{Binding DataContext.OrbTitleLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         Dark="{Binding DataContext.DarkTheme, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         ReduceMotion="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="2,2,8,6" TextWrapping="Wrap" FontSize="12">
                        <Run Text="{Binding SelectedStyleName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  " />
                        <Run Text="{Binding SelectedStyleDescription, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Character (DESIGN 5, characters.title; CHARACTERS 2, 7): only for a character orb, under the style cards -->
            <StackPanel Visibility="{Binding IsCharacter, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:Loc characters.title}" Style="{StaticResource SectionHeaderText}" Margin="2,22,0,8"
                           AutomationProperties.HeadingLevel="Level3" />
                <Border Style="{StaticResource GroupBorder}" Padding="16,4,16,8">
                    <StackPanel>
                        <DockPanel MinHeight="56">
                            <ComboBox DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center" ItemsSource="{Binding CharacterChoices}"
                                      DisplayMemberPath="Name" SelectedIndex="{Binding CharacterChoiceIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="{loc:Loc characters.choice}" AutomationProperties.HelpText="{loc:Loc characters.choice.hint}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Loc characters.choice}" FontSize="13" />
                                <TextBlock Text="{loc:Loc characters.choice.hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <!-- The automatic download's progress with Stop (CHARACTERS 2, Automatic download) -->
                        <DockPanel MinHeight="40" Visibility="{Binding AutoRunning, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="{Binding AutoStatus}">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc characters.auto.stop}" Command="{Binding CharacterStopCommand}"
                                    VerticalAlignment="Center" MinWidth="72" />
                            <ProgressBar Width="96" Height="4" Minimum="0" Maximum="1" Value="{Binding AutoProgress, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AutoStatus}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,10,0"
                                       Typography.NumeralAlignment="Tabular" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource Hairline}" Margin="0,2,0,2" />
                        <ItemsControl ItemsSource="{Binding CharacterRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pane:CharacterRowViewModel}">
                                    <Grid MinHeight="64" Margin="0,4,0,4" AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Portrait}" Height="56" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasPortrait, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE77B;" FontSize="26" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding HasPortrait, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                                                <TextBlock Text="{loc:Loc characters.development}" Style="{StaticResource CaptionText}" FontSize="10" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" Visibility="{Binding Development, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Button Style="{StaticResource LinkButton}" Content="{Binding Artist}" Padding="0" FontSize="11" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.CharacterArtistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="{Binding ArtistLink}"
                                                        Visibility="{Binding HasArtistLink, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Artist}" Style="{StaticResource CaptionText}" Margin="0,0,8,0"
                                                           Visibility="{Binding HasArtistText, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Size}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{loc:Loc characters.download}" Style="{DynamicResource AccentButtonStyle}" MinWidth="80"
                                                    IsEnabled="{Binding DownloadEnabled}"
                                                    Command="{Binding DataContext.CharacterDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Downloading, Converter={StaticResource BoolToVisibility}}">
                                                <ProgressBar Width="72" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource SubtleButton}" Margin="6,0,0,0" ToolTip="{loc:Loc characters.cancel}"
                                                        AutomationProperties.Name="{loc:Loc characters.cancel}"
                                                        Command="{Binding DataContext.CharacterCancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEB90;" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Installing, Converter={StaticResource BoolToVisibility}}">
                                                <ProgressBar Width="40" Height="4" IsIndeterminate="True" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc characters.installing}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Content="{loc:Loc characters.update}" Margin="0,0,6,0" IsEnabled="{Binding DownloadEnabled}"
                                                    Command="{Binding DataContext.CharacterDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{loc:Loc characters.remove}" Style="{StaticResource LinkButton}"
                                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    Command="{Binding DataContext.CharacterRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- No rows: loading, unavailable with Retry, or offline -->
                        <DockPanel MinHeight="40" Visibility="{Binding CharacterListEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc characters.retry}" Command="{Binding CharacterRetryCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding CharacterRetryVisible, Converter={StaticResource BoolToVisibility}}" />
                            <ProgressBar Width="24" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Visibility="{Binding CharacterLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CharacterEmptyText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <DockPanel Margin="4,6,4,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:Loc characters.openFolder}" FontSize="11"
                            Command="{Binding CharacterFolderCommand}" VerticalAlignment="Top" />
                    <TextBlock Text="{loc:Loc characters.footer}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,12,0" />
                </DockPanel>

                <!-- The cards (DESIGN 2a.6, Readouts) in place of the unit and the two-line readout -->
                <TextBlock Text="{loc:Loc character.readouts}" Style="{StaticResource SectionHeaderText}" Margin="2,22,0,8"
                           AutomationProperties.HeadingLevel="Level3" />
                <Border Style="{StaticResource GroupBorder}" Padding="16,10,16,10">
                    <StackPanel>
                        <UniformGrid Columns="2">
                            <CheckBox Content="{loc:Loc character.readouts.intel}" IsChecked="{Binding ReadoutIntel, Mode=TwoWay}" Margin="0,4,0,4" />
                            <CheckBox Content="{loc:Loc character.readouts.thinking}" IsChecked="{Binding ReadoutThinking, Mode=TwoWay}" Margin="0,4,0,4" />
                            <CheckBox Content="{loc:Loc character.readouts.network}" IsChecked="{Binding ReadoutNetwork, Mode=TwoWay}" Margin="0,4,0,4"
                                      IsEnabled="{Binding TrafficMeasured}" />
                            <CheckBox Content="{loc:Loc character.readouts.cost}" IsChecked="{Binding ReadoutCost, Mode=TwoWay}" Margin="0,4,0,4" />
                            <CheckBox Content="{loc:Loc character.readouts.agents}" IsChecked="{Binding ReadoutAgents, Mode=TwoWay}" Margin="0,4,0,4" />
                            <CheckBox Content="{loc:Loc character.readouts.model}" IsChecked="{Binding ReadoutModel, Mode=TwoWay}" Margin="0,4,0,4" />
                        </UniformGrid>
                        <Rectangle Style="{StaticResource Hairline}" Margin="0,6,0,2" />
                        <DockPanel MinHeight="44" IsEnabled="{Binding NetworkScopeEnabled}">
                            <ComboBox DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center" SelectedIndex="{Binding NetworkScopeIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="{loc:Loc character.readouts.networkScope}">
                                <ComboBoxItem Content="{loc:Loc orbs.traffic.sources}" />
                                <ComboBoxItem Content="{loc:Loc orbs.traffic.machine}" />
                            </ComboBox>
                            <TextBlock Text="{loc:Loc character.readouts.networkScope}" VerticalAlignment="Center" FontSize="13" />
                        </DockPanel>
                        <TextBlock Text="{loc:Loc character.readouts.hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding IsNotCharacter, Converter={StaticResource BoolToVisibility}}">
            <!-- Unit (DESIGN 9 Orb, Switching 3): tok/s or the money unit, directly under the style cards -->
            <Border Style="{StaticResource GroupBorder}" Margin="0,16,0,0" Padding="16,4,16,4">
                <DockPanel MinHeight="48">
                    <TextBlock Text="{loc:Loc orbs.unit}" VerticalAlignment="Center" FontSize="13" />
                    <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Loc orbs.unit}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OrbUnit" Content="{loc:Loc settings.liveUnit.tokens}"
                                         IsChecked="{Binding UnitTokens, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc orbs.unit.tokens}" />
                            <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OrbUnit" Content="{Binding UnitCostLabel}"
                                         IsChecked="{Binding UnitCost, Mode=TwoWay}" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Two-line readout (DESIGN 10): network speed, live intelligence or nothing, under the unit control -->
            <Border Style="{StaticResource GroupBorder}" Margin="0,8,0,0" Padding="16,4,16,12">
                <StackPanel>
                    <DockPanel MinHeight="48">
                        <TextBlock Text="{loc:Loc orbs.traffic}" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox MinWidth="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectedIndex="{Binding TrafficIndex, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc orbs.traffic}"
                                  AutomationProperties.HelpText="{Binding TrafficHint}">
                            <ComboBoxItem Content="{loc:Loc orbs.traffic.sources}" />
                            <ComboBoxItem Content="{loc:Loc orbs.traffic.machine}" />
                            <ComboBoxItem Content="{loc:Loc orbs.traffic.intelligence}" />
                            <ComboBoxItem Content="{loc:Loc orbs.traffic.off}" />
                        </ComboBox>
                    </DockPanel>
                    <TextBlock Text="{Binding TrafficHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Size and opacity -->
            <Border Style="{StaticResource GroupBorder}" Margin="0,16,0,0" Padding="16,4,16,4">
                <StackPanel>
                    <DockPanel MinHeight="48">
                        <TextBlock Text="{loc:Loc settings.orb.size}" VerticalAlignment="Center" FontSize="13" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource SegmentedContainer}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OrbSize" Content="{loc:Loc menu.size.small}" IsChecked="{Binding SizeSmall, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OrbSize" Content="{loc:Loc menu.size.medium}" IsChecked="{Binding SizeMedium, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OrbSize" Content="{loc:Loc menu.size.large}" IsChecked="{Binding SizeLarge, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                            <Slider Width="180" Minimum="{Binding SizeMinimum}" Maximum="240" TickFrequency="4" IsSnapToTickEnabled="True"
                                    SmallChange="4" LargeChange="24" VerticalAlignment="Center" Value="{Binding SizeValue, Mode=TwoWay}"
                                    AutomationProperties.Name="{loc:Loc settings.orb.size}" />
                            <TextBlock Text="{Binding SizeText}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Hairline}" />
                    <DockPanel MinHeight="48">
                        <TextBlock Text="{loc:Loc settings.orb.opacity}" VerticalAlignment="Center" FontSize="13" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Slider Width="220" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                                    VerticalAlignment="Center" Value="{Binding OpacityPercent, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc settings.orb.opacity}" />
                            <TextBlock Text="{Binding OpacityText}" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Hairline}" />
                    <!-- orbs.showName: automatic (with its result), a separator, on, off (DESIGN 2b, Name plate) -->
                    <DockPanel MinHeight="48">
                        <TextBlock Text="{loc:Loc orbs.showName}" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox MinWidth="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectedIndex="{Binding ShowNameIndex, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc orbs.showName}">
                            <ComboBoxItem Content="{Binding ShowNameAutoText}" />
                            <ComboBoxItem IsEnabled="False" Focusable="False" IsHitTestVisible="False" MinHeight="0" Padding="0"
                                          HorizontalContentAlignment="Stretch">
                                <Separator Margin="0,3,0,3" />
                            </ComboBoxItem>
                            <ComboBoxItem Content="{loc:Loc orbs.showName.on}" />
                            <ComboBoxItem Content="{loc:Loc orbs.showName.off}" />
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Switches -->
            <StackPanel Margin="0,16,0,0">
                <controls:SettingsCard Header="{loc:Loc menu.alwaysOnTop}" Icon="&#xE718;">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc menu.alwaysOnTop}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{loc:Loc menu.clickThrough}" Icon="&#xE7C9;" Description="{Binding ClickThroughHint}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickThrough, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc menu.clickThrough}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{loc:Loc settings.orb.fadeIdle}" Icon="&#xE708;" Description="{Binding FadeHint}">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FadeWhenIdle, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc settings.orb.fadeIdle}" />
                </controls:SettingsCard>
                <Button Style="{StaticResource LinkButton}" Content="{loc:Loc win.settings.resetPosition}" Command="{Binding ResetPositionCommand}"
                        Margin="2,2,0,0" FontSize="12" />
            </StackPanel>

            <!-- Advanced -->
            <Border Style="{StaticResource GroupBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Height="52">
                        <Button Command="{Binding ToggleAdvancedCommand}" Style="{StaticResource SubtleButton}" Height="52" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{loc:Loc orbs.advanced}" AutomationProperties.HelpText="{Binding AdvancedSummary}" />
                        <DockPanel Margin="16,0,14,0" IsHitTestVisible="False">
                            <TextBlock x:Name="AdvancedChevron" DockPanel.Dock="Right" Style="{StaticResource SymbolIcon}" FontSize="12" Text="&#xE70D;"
                                       Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AdvancedSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{loc:Loc orbs.advanced}" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                    <StackPanel Margin="16,0,16,14" Visibility="{Binding AdvancedExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Style="{StaticResource Hairline}" Margin="-16,0,-16,12" />
                        <TextBlock Text="{loc:Loc orbs.name}" FontSize="13" Margin="0,0,0,6" />
                        <Grid>
                            <TextBox x:Name="NameBox" Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="32"
                                     AutomationProperties.Name="{loc:Loc orbs.name}" AutomationProperties.HelpText="{Binding NamePlaceholder}" />
                            <TextBlock Text="{Binding NamePlaceholder}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- This orb's title theme (DESIGN 2b titleTheme; sets are edited in General) -->
                        <TextBlock Text="{loc:Loc titles.theme}" FontSize="13" Margin="0,16,0,6" />
                        <ComboBox x:Name="ThemeCombo" MinWidth="240" HorizontalAlignment="Left" SelectedIndex="{Binding TitleThemeIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Loc titles.theme}" AutomationProperties.HelpText="{Binding TitleThemeHint}" />
                        <TextBlock Text="{Binding TitleThemeHint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:Loc settings.redline}" FontSize="13" Margin="0,16,0,6" />
                        <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OrbRedline" Content="{Binding RedlineGlobalText}"
                                             IsChecked="{Binding RedlineGlobal, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OrbRedline" Content="{Binding RedlineCustomText}"
                                             IsChecked="{Binding RedlineCustom, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding RedlineCustom, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Slider Minimum="50" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="200"
                                        Value="{Binding RedlineOutputValue, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc settings.redline}"
                                        Visibility="{Binding IsOutputMetric, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                                <Slider Minimum="{Binding RedlineTotalMinimumLog}" Maximum="{Binding RedlineTotalMaximumLog}" SmallChange="0.02" LargeChange="0.1"
                                        Value="{Binding RedlineTotalLog, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc settings.redline}"
                                        Visibility="{Binding IsTotalMetric, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding RedlineText}" MinWidth="96" TextAlignment="Right" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <controls:HeatStrip Grid.Row="1" Grid.Column="0" Margin="10,4,10,0" Ticks="{Binding TitleTicks}"
                                                    TickBrush="{DynamicResource TextFillColorTertiaryBrush}" HighlightBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                    HighlightIndex="{Binding HighlightIndex, ElementName=OrbLadder}" />
                            </Grid>
                            <TextBlock Text="{Binding RedlineHint}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                            <!-- The titles at this redline, in this orb's theme -->
                            <tt:TitleLadderList x:Name="OrbLadder" Rows="{Binding TitleLadder}" Margin="0,12,0,0" HeadingLevel="Level4" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Leaderboard boards (DESIGN 2c): their list and editor under the orbs -->
        <boards:BoardsSection DataContext="{Binding DataContext.Boards, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </StackPanel>
</UserControl>
