<UserControl x:Class="AgentSpeed.Settings.Pages.SourcesPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:history="clr-namespace:AgentSpeed.History"
             xmlns:settings="clr-namespace:AgentSpeed.Settings"
             xmlns:sources="clr-namespace:AgentSpeed.Settings.Sources"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <controls:InverseBoolToVisibilityConverter x:Key="Hidden" />

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Show in File Explorer and Remove: quiet icon buttons that keep a 32 px target. -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
        </Style>

        <!-- One source of the group: its color, name and status line, and its switch. -->
        <DataTemplate x:Key="ToggleRow" DataType="{x:Type settings:SourceSettingsRow}">
            <Grid>
                <Rectangle x:Name="Divider" Style="{StaticResource Hairline}" VerticalAlignment="Top" />
                <Grid Margin="16,11,16,11" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{Binding Dot}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,7,0,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Status}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ZCode's key and region under its switch (QUOTAS 9.8): labels on the title's line, fields on the switch's trailing
             edge. A pasted key is saved to Credential Manager on Enter or when focus leaves, and is never shown again. -->
        <DataTemplate x:Key="ZcodeFieldRows" DataType="{x:Type sources:ZcodeFieldsViewModel}">
            <StackPanel x:Name="FieldsRoot">
                <Rectangle Style="{StaticResource Hairline}" Margin="36,0,0,0" />
                <Grid Margin="16,10,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KeyLabel" Grid.Column="1" Text="{loc:Loc settings.quota.zcode.key}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <Grid Grid.Column="2" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Both states keep their room, so the row never changes height when the key is saved or removed. -->
                        <Grid x:Name="KeyEntry" Width="240" HorizontalAlignment="Right">
                            <PasswordBox x:Name="ZcodeKeyBox" FontSize="13" MaxLength="1024" KeyDown="OnZcodeKeyDown" LostKeyboardFocus="OnZcodeKeyLostFocus"
                                         PasswordChanged="OnZcodeKeyChanged" AutomationProperties.Name="{loc:Loc settings.quota.zcode.key}"
                                         AutomationProperties.HelpText="{loc:Loc settings.quota.zcode.keyPlaceholder}" />
                            <TextBlock x:Name="KeyPlaceholder" Text="{loc:Loc settings.quota.zcode.keyPlaceholder}" IsHitTestVisible="False" FontSize="13"
                                       Margin="12,0,12,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <StackPanel x:Name="KeySaved" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Hidden">
                            <controls:SymbolGlyph x:Name="KeyGlyph" Style="{StaticResource SymbolIcon}" Text="&#xE8D7;" FontSize="13" Margin="0,1,7,0"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="KeySavedText" Text="{loc:Loc win.settings.quota.zcode.saved}" FontSize="13" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="ZcodeRemove" Content="{loc:Loc settings.quota.zcode.remove}" Command="{Binding RemoveCommand}"
                                    Click="OnZcodeRemoveClick" MinWidth="80" Margin="14,0,0,0"
                                    AutomationProperties.HelpText="{loc:Loc win.settings.quota.zcode.saved}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" Margin="36,0,0,0" />
                <Grid Margin="16,10,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RegionLabel" Grid.Column="1" Text="{loc:Loc settings.quota.zcode.region}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <ComboBox Grid.Column="2" Width="240" Margin="0,0,12,0" VerticalAlignment="Center" SelectedIndex="{Binding RegionIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Loc settings.quota.zcode.region}">
                        <ComboBoxItem Content="{loc:Loc settings.quota.zcode.regionGlobal}" />
                        <ComboBoxItem Content="{loc:Loc settings.quota.zcode.regionCn}" />
                    </ComboBox>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter TargetName="KeyEntry" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="KeySaved" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, ElementName=FieldsRoot}" Value="False">
                    <Setter TargetName="KeyLabel" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="RegionLabel" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="KeyGlyph" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="KeySavedText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A quota switch of the group (DESIGN 5, 額度): a gauge in the dot column, the title, its hint and a quieter note as the
             caption, and a status line (a glyph before secondary text; the bridge offers Reconnect inside it). Grok's live
             request is indented under the switch it needs; ZCode adds its key and region while on. A disabled source dims the
             row and nothing can be switched (QUOTAS 9.1). -->
        <DataTemplate x:Key="QuotaRow" DataType="{x:Type sources:QuotaRowViewModel}">
            <StackPanel x:Name="Root" IsEnabled="{Binding CanSwitch}">
                <Rectangle x:Name="Divider" Style="{StaticResource Hairline}" VerticalAlignment="Top" />
                <Grid Margin="16,11,16,12" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Two small quota bars in the dot column: the row reads as the source's quota lines. -->
                    <StackPanel x:Name="Gauge" Width="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,6,0,0" IsHitTestVisible="False"
                                SnapsToDevicePixels="True">
                        <Grid Height="3">
                            <Border CornerRadius="1.5" Background="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.3" />
                            <Border CornerRadius="1.5" Background="{DynamicResource TextFillColorSecondaryBrush}" Width="7" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid Height="3" Margin="0,2,0,0">
                            <Border CornerRadius="1.5" Background="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.3" />
                            <Border CornerRadius="1.5" Background="{DynamicResource TextFillColorSecondaryBrush}" Width="4" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="Texts" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="Hint" Text="{Binding Hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="17" Margin="0,3,0,0"
                                   Visibility="{Binding HasHint, Converter={StaticResource Visible}}" />
                        <TextBlock x:Name="Note" Text="{Binding Note}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" LineHeight="17" Margin="0,2,0,0" Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                        <Grid x:Name="StatusLine" Margin="0,7,0,0" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="StatusGlyph" Width="12" Height="12" Margin="0,3,6,0" VerticalAlignment="Top" Visibility="Collapsed">
                                <controls:SymbolGlyph x:Name="StatusIcon" Style="{StaticResource SymbolIcon}" Text="&#xE73E;" FontSize="12"
                                                      Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <!-- Paused: a ring with two bars, drawn with the symbol font so it stays crisp. -->
                                <controls:SymbolGlyph x:Name="PauseBars" Style="{StaticResource SymbolIcon}" Text="&#xF8AE;" FontSize="6"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                            </Grid>
                            <!-- Reconnect is a link inside the status text, so a long path wraps with it. -->
                            <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="17"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Status}">
                                <Run Text="{Binding Status, Mode=OneWay}" /><Run Text="{Binding ReconnectGap, Mode=OneWay}" /><Hyperlink
                                    Command="{Binding ReconnectCommand}" Focusable="{Binding ShowsReconnect}" TextDecorations="{x:Null}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    AutomationProperties.Name="{Binding ReconnectText}"><Run Text="{Binding ReconnectLink, Mode=OneWay}" /></Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding HelpText}"
                              AutomationProperties.ItemStatus="{Binding Status}" />
                </Grid>

                <!-- ZCode's key and region (QUOTAS 9.8), built only for the ZCode switch. -->
                <ContentControl x:Name="ZcodeFields" Content="{Binding Zcode}" ContentTemplate="{StaticResource ZcodeFieldRows}" Focusable="False"
                                IsTabStop="False" Visibility="{Binding ShowsZcodeFields, Converter={StaticResource Visible}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIndented}" Value="True">
                    <Setter TargetName="Divider" Property="Margin" Value="36,0,0,0" />
                    <Setter TargetName="Gauge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Texts" Property="Margin" Value="20,0,24,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusMark}" Value="Ok">
                    <Setter TargetName="StatusGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusMark}" Value="Warning">
                    <Setter TargetName="StatusGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusMark}" Value="NetworkOff">
                    <Setter TargetName="StatusGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Text" Value="&#xEB5E;" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusMark}" Value="Paused">
                    <Setter TargetName="StatusGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Text" Value="&#xEA3A;" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter TargetName="PauseBars" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanSwitch}" Value="False">
                    <Setter TargetName="Gauge" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="Hint" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowsZcodeFields}" Value="True" />
                        <Condition Binding="{Binding DataContext.SourcesPane.ReduceMotion, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ZcodeFields" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One folder line: the path cut in the middle when it does not fit, then the 預設 badge on the automatic entry's first line. -->
        <DataTemplate x:Key="PathLine" DataType="{x:Type sources:LocationLineViewModel}">
            <controls:ShrinkFirstPanel Background="Transparent" ToolTip="{Binding FullPath}" ToolTipService.InitialShowDelay="600">
                <history:MiddleTrimmedText x:Name="Path" Text="{Binding Display}" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border x:Name="Badge" Margin="8,0,0,0" Padding="7,1,7,2" CornerRadius="9" VerticalAlignment="Center" BorderThickness="1"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding ShowsBadge, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding DataContext.BadgeText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </controls:ShrinkFirstPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Dimmed}" Value="True">
                    <Setter TargetName="Path" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One entry of the list (DESIGN 5): icon, path(s), missing state, Show in File Explorer and Remove. -->
        <DataTemplate x:Key="LocationRow" DataType="{x:Type sources:LocationRowViewModel}">
            <Grid x:Name="Row" Background="Transparent" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Shift" />
                </Grid.RenderTransform>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding RevealText}" Command="{Binding RevealCommand}" />
                        <MenuItem Header="{Binding CopyText}" Command="{Binding CopyCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding RemoveText}" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Rectangle x:Name="Divider" Style="{StaticResource Hairline}" VerticalAlignment="Top" />
                <Grid Margin="16,8,10,8" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Icon" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="{Binding FallbackGlyph}" FontSize="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasIcon, Converter={StaticResource Hidden}}" />
                    </Grid>
                    <sources:LocationPathPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding AccessibleName}">
                        <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource PathLine}" Focusable="False" IsTabStop="False">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,1,0,1" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,1" Visibility="{Binding IsMissing, Converter={StaticResource Visible}}">
                            <controls:SymbolGlyph Style="{StaticResource SymbolIcon}" Text="&#xE7BA;" FontSize="12" Margin="0,1,6,0"
                                                  Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{Binding MissingText}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </sources:LocationPathPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowIconButton}" Command="{Binding RevealCommand}" ToolTip="{Binding RevealText}"
                                AutomationProperties.Name="{Binding RevealName}">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE838;" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="RemoveButton" Style="{StaticResource RowIconButton}" Command="{Binding RemoveCommand}" Margin="2,0,0,0"
                                ToolTip="{Binding RemoveTooltip}" AutomationProperties.Name="{Binding RemoveName}"
                                AutomationProperties.HelpText="{Binding RemoveTooltip}">
                            <!-- A minus in a ring (DESIGN 5: minus circle), drawn with the symbol font so it stays crisp. -->
                            <Grid>
                                <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEA3A;" FontSize="16"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE738;" FontSize="8"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Leave">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Leave" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding SourcesPane.Caption}" Style="{StaticResource CaptionText}" FontSize="13" LineHeight="20" Margin="2,0,2,16" />

        <ItemsControl x:Name="Groups" ItemsSource="{Binding SourcesPane.Groups}" Focusable="False" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type sources:SourceGroupViewModel}">
                    <StackPanel Margin="0,0,0,20">
                        <Border Style="{StaticResource GroupBorder}" AutomationProperties.Name="{Binding GroupName}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Toggles}" ItemTemplate="{StaticResource ToggleRow}" Focusable="False" IsTabStop="False" />
                                <ItemsControl ItemsSource="{Binding QuotaToggles}" ItemTemplate="{StaticResource QuotaRow}" Focusable="False" IsTabStop="False"
                                              Visibility="{Binding HasQuota, Converter={StaticResource Visible}}" />
                                <Rectangle Style="{StaticResource Hairline}" />
                                <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource LocationRow}" Focusable="False" IsTabStop="False"
                                              Tag="{Binding}" />
                                <Rectangle Style="{StaticResource Hairline}" />
                                <!-- Add Folder… and Reset, leading; at the limit the limit reads at the trailing end. -->
                                <DockPanel Margin="16,10,16,12">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LimitText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" Margin="12,0,0,0" Visibility="{Binding CanAdd, Converter={StaticResource Hidden}}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AddButton" Content="{Binding AddText}" Command="{Binding AddCommand}" MinWidth="112"
                                                ToolTip="{Binding AddTooltip}" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.HelpText="{Binding AddTooltip}" />
                                        <Button x:Name="ResetButton" Content="{Binding ResetText}" Command="{Binding ResetCommand}" MinWidth="80" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Footnote}" Style="{StaticResource CaptionText}" LineHeight="17" Margin="2,8,2,0"
                                   Visibility="{Binding HasFootnote, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:SettingsCard Header="{loc:Loc history.title}" Description="{loc:Loc history.privacy}" Icon="&#xE81C;" ContentBelow="True"
                               Margin="0,4,0,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{loc:Loc history.open}" Command="{Binding OpenHistoryCommand}" MinWidth="104" />
                <Button Content="{loc:Loc history.clear}" Command="{Binding ClearHistoryCommand}" MinWidth="104" Margin="8,0,0,0" />
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
