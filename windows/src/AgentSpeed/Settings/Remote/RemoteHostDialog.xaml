<Window x:Class="AgentSpeed.Settings.Remote.RemoteHostDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AgentSpeed.Localization"
        xmlns:controls="clr-namespace:AgentSpeed.Controls"
        xmlns:theme="clr-namespace:AgentSpeed.Theme"
        xmlns:remote="clr-namespace:AgentSpeed.Settings.Remote"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Title="{Binding Title}"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.Name="{Binding Title}"
        AutomationProperties.HelpText="{loc:Loc remote.sheet.body}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <controls:TextToVisibilityConverter x:Key="HasText" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="12,0,12,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- A field's problem right under it: a small red mark and the sentence, wrapping in the field's column. -->
        <DataTemplate x:Key="FieldError">
            <DockPanel Margin="0,6,0,0">
                <controls:SymbolGlyph Style="{StaticResource SymbolIcon}" Text="&#xEA39;" FontSize="12" VerticalAlignment="Top" Margin="0,2,6,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" LineHeight="17" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,22,24,22">
            <!-- Title and what to type -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:AccentBadge Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,12,0">
                    <controls:SymbolGlyph Style="{StaticResource SymbolIcon}" Text="&#xE968;" FontSize="16" Foreground="White" />
                </controls:AccentBadge>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1" />
            </Grid>
            <TextBlock Text="{loc:Loc remote.sheet.body}" Style="{StaticResource CaptionText}" FontSize="13" LineHeight="19" Margin="0,12,0,0" />

            <!-- Destination and name -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,14,16,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc remote.destination}" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <TextBox x:Name="DestinationBox" Text="{Binding Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="255"
                                 FontFamily="{x:Static theme:AppFonts.Monospace}" FontSize="13"
                                 AutomationProperties.Name="{loc:Loc remote.destination}" AutomationProperties.HelpText="{Binding DestinationPlaceholder}"
                                 AutomationProperties.ItemStatus="{Binding DestinationError}" />
                        <TextBlock Text="{Binding DestinationPlaceholder}" Style="{StaticResource Placeholder}" FontFamily="{x:Static theme:AppFonts.Monospace}"
                                   FontSize="13" Visibility="{Binding Text, ElementName=DestinationBox, Converter={StaticResource HasText}, ConverterParameter=invert}" />
                    </Grid>
                    <ContentControl Focusable="False" IsTabStop="False" Content="{Binding DestinationError}" ContentTemplate="{StaticResource FieldError}"
                                      Visibility="{Binding DestinationError, Converter={StaticResource HasText}}" />

                    <TextBlock Text="{loc:Loc remote.name}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <Grid>
                        <TextBox x:Name="NameBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" FontSize="13"
                                 AutomationProperties.Name="{loc:Loc remote.name}" AutomationProperties.HelpText="{Binding NamePlaceholder}"
                                 AutomationProperties.ItemStatus="{Binding NameError}" />
                        <TextBlock Text="{Binding NamePlaceholder}" Style="{StaticResource Placeholder}" FontSize="13"
                                   Visibility="{Binding Text, ElementName=NameBox, Converter={StaticResource HasText}, ConverterParameter=invert}" />
                    </Grid>
                    <ContentControl Focusable="False" IsTabStop="False" Content="{Binding NameError}" ContentTemplate="{StaticResource FieldError}"
                                      Visibility="{Binding NameError, Converter={StaticResource HasText}}" />
                </StackPanel>
            </Border>

            <!-- Advanced: the folder on the host -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid MinHeight="48">
                        <Button x:Name="AdvancedButton" Command="{Binding ToggleAdvancedCommand}" Style="{StaticResource SubtleButton}" Height="Auto"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="{loc:Loc remote.advanced}"
                                AutomationProperties.HelpText="{Binding AdvancedSummary}" />
                        <DockPanel Margin="16,0,14,0" IsHitTestVisible="False">
                            <TextBlock x:Name="AdvancedChevron" DockPanel.Dock="Right" Style="{StaticResource SymbolIcon}" FontSize="11" Text="&#xE76C;"
                                       Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="ChevronTurn" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AdvancedSummary}" FontFamily="{x:Static theme:AppFonts.Monospace}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="230" Visibility="{Binding AdvancedCollapsed, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{loc:Loc remote.advanced}" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                    <StackPanel Margin="16,0,16,16" Visibility="{Binding AdvancedExpanded, Converter={StaticResource Visible}}">
                        <Rectangle Style="{StaticResource Hairline}" Margin="-16,0,-16,14" />
                        <TextBlock Text="{loc:Loc remote.relayFolder}" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <TextBox x:Name="FolderBox" Text="{Binding RelayFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                     FontFamily="{x:Static theme:AppFonts.Monospace}" FontSize="13"
                                     AutomationProperties.Name="{loc:Loc remote.relayFolder}" AutomationProperties.HelpText="{loc:Loc remote.relayFolder.hint}"
                                     AutomationProperties.ItemStatus="{Binding FolderError}" />
                            <TextBlock Text="{Binding FolderPlaceholder}" Style="{StaticResource Placeholder}" FontFamily="{x:Static theme:AppFonts.Monospace}"
                                       FontSize="13" Visibility="{Binding Text, ElementName=FolderBox, Converter={StaticResource HasText}, ConverterParameter=invert}" />
                        </Grid>
                        <ContentControl Focusable="False" IsTabStop="False" Content="{Binding FolderError}" ContentTemplate="{StaticResource FieldError}"
                                          Visibility="{Binding FolderError, Converter={StaticResource HasText}}" />
                        <TextBlock Text="{loc:Loc remote.relayFolder.hint}" Style="{StaticResource CaptionText}" LineHeight="17" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The host's Claude Code bridge (DESIGN 13, Host quotas): the switch with its caption, then the bridge's state as
                 Settings → Data Sources words it (a glyph before secondary text; Reconnect inside the text when replaced). -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,13,16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{loc:Loc remote.quota.claudeCli}" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc remote.quota.claudeCli.hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="17"
                                   Margin="0,3,0,0" />
                        <Grid Margin="0,7,0,0" Visibility="{Binding ShowsBridge, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:SymbolGlyph x:Name="BridgeMark" Style="{StaticResource SymbolIcon}" FontSize="12" Width="12" Height="12"
                                                  Margin="0,3,6,0" VerticalAlignment="Top" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="17"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding BridgeText}">
                                <Run Text="{Binding BridgeText, Mode=OneWay}" /><Run Text="{Binding ReconnectGap, Mode=OneWay}" /><Hyperlink
                                    Command="{Binding ReconnectCommand}" Focusable="{Binding ShowsReconnect}" TextDecorations="{x:Null}"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    AutomationProperties.Name="{Binding ReconnectText}"><Run Text="{Binding ReconnectLink, Mode=OneWay}" /></Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <CheckBox x:Name="BridgeSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding QuotaClaudeCli, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Loc remote.quota.claudeCli}" AutomationProperties.HelpText="{loc:Loc remote.quota.claudeCli.hint}"
                              AutomationProperties.ItemStatus="{Binding BridgeText}" />
                </Grid>
            </Border>

            <!-- Test Connection and its result inline -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,12,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TestButton" Content="{loc:Loc remote.test}" Command="{Binding TestCommand}" MinWidth="120" VerticalAlignment="Top"
                            ToolTip="{Binding TestUnavailableReason}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.HelpText="{Binding TestUnavailableReason}" />
                    <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MinHeight="20">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsTesting, Converter={StaticResource Visible}}">
                            <controls:ProgressRing Width="14" Height="14" Thickness="2" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TestText}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <DockPanel x:Name="TestResult" Visibility="{Binding HasTestResult, Converter={StaticResource Visible}}">
                            <controls:SymbolGlyph x:Name="TestMark" Style="{StaticResource SymbolIcon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,7,0"
                                       />
                            <TextBox x:Name="TestTextBox" Text="{Binding TestText, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="12"
                                     TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-2,0,0,0"
                                     AutomationProperties.Name="{Binding TestText}" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Command area, as in a WinUI content dialog: the primary action on the left and default, Cancel on the right -->
        <Border Grid.Row="1" Padding="24" BorderThickness="0,1,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton" Grid.Column="0" Height="32" FontSize="14" HorizontalAlignment="Stretch" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" Content="{Binding SaveText}" IsEnabled="{Binding CanSave}" Click="OnSave" />
                <Button x:Name="CancelButton" Grid.Column="2" Height="32" FontSize="14" HorizontalAlignment="Stretch" IsCancel="True"
                        Content="{loc:Loc history.cancel}" />
            </Grid>
        </Border>
    </Grid>
</Window>
