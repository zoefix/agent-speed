<UserControl x:Class="AgentSpeed.History.Perf.PerfTableView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:history="clr-namespace:AgentSpeed.History"
             xmlns:perf="clr-namespace:AgentSpeed.History.Perf"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Perf;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False">
    <!-- The 性能表現 table (DESIGN 12, Table): a native table in the daily table's style — 30 DIP rows, alternating tint, hover
         highlight, sortable headers that keep room for the sort glyph, the selection that picks the chart's series, copy row
         as text — and, narrow, a list of selectable rows. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentSpeed;component/History/Perf/PerfResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The empty room to the right of the last column. -->
            <Style x:Key="PaddingHeader" TargetType="GridViewColumnHeader">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Headers, a hairline and the rows; no scroller of its own, so the page scrolls over it and nothing scrolls sideways. -->
            <Style x:Key="TableStyle" TargetType="ListView">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListView">
                            <StackPanel>
                                <GridViewHeaderRowPresenter x:Name="HeaderRow" AllowsColumnReorder="False"
                                                            Columns="{Binding View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderContainerStyle="{StaticResource PaddingHeader}"
                                                            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained" />
                                <Rectangle Height="1" Margin="0,0,0,2" SnapsToDevicePixels="True" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <ItemsPresenter KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <history:SpringStackPanel ReduceMotion="{Binding (perf:PerfHistoryAppearance.ReduceMotion), RelativeSource={RelativeSource Self}}" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A sortable header (the window's HeaderButton): secondary text, primary when sorted or hovered, the cells' padding. -->
            <Style x:Key="HeaderStyle" TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="6,6,6,6" />
                <Setter Property="VerticalContentAlignment" Value="Bottom" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Grid>
                                <Border x:Name="Chip" CornerRadius="4" Background="{TemplateBinding Background}" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row: alternating tint, the selection and hover chip; one element named with every column. -->
            <Style x:Key="TableRow" TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Height" Value="{x:Static layout:PerfHistoryLayout.RowHeight}" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Chip" CornerRadius="4" Background="{TemplateBinding Background}">
                                <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A numeric cell: 12 DIP tabular, right-aligned, in secondary for a row without a score. -->
            <Style x:Key="NumberCell" TargetType="perf:PerfFadeText">
                <Setter Property="FontSize" Value="{x:Static layout:PerfHistoryLayout.CellSize}" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Secondary" Value="{Binding LowSample}" />
            </Style>

            <!-- The model id: 12.5 DIP medium, middle truncation; an unknown model in secondary italic. -->
            <Style x:Key="ModelId" TargetType="history:MiddleTrimmedText">
                <Setter Property="FontSize" Value="{x:Static layout:PerfHistoryLayout.ModelSize}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Text" Value="{Binding ModelText}" />
                <Setter Property="ToolTip" Value="{Binding ModelText}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The model cell: the source dot, the id with the few-samples chip after it, then the source name. -->
            <DataTemplate x:Key="ModelCell" DataType="{x:Type perf:PerfRowView}">
                <DockPanel Background="Transparent">
                    <history:SourceDot DockPanel.Dock="Left" Colors="{Binding SourceColors}" Width="{x:Static layout:PerfHistoryLayout.SourceDot}"
                                       Height="{x:Static layout:PerfHistoryLayout.SourceDot}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <controls:ShrinkFirstPanel VerticalAlignment="Center">
                        <history:MiddleTrimmedText Style="{StaticResource ModelId}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <perf:PerfSampleChip Text="{Binding SampleLow}" ToolTip="{Binding ScoreTooltip}" Margin="7,0,0,0"
                                                 Visibility="{Binding LowSample, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding SourceName}" FontSize="{x:Static layout:PerfHistoryLayout.SourceSize}" Margin="7,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </controls:ShrinkFirstPanel>
                </DockPanel>
            </DataTemplate>

            <!-- The pooled score (13 DIP semibold, full form) and its 36 × 4 meter; – with the sample hint below 20 timed requests. -->
            <DataTemplate x:Key="ScoreCell" DataType="{x:Type perf:PerfRowView}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent" ToolTip="{Binding ScoreTooltip}"
                            ToolTipService.IsEnabled="{Binding LowSample}">
                    <perf:PerfFadeText Text="{Binding ScoreText}" FontSize="{x:Static layout:PerfHistoryLayout.ScoreSize}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Absent="{Binding LowSample}" />
                    <perf:PerfMeterBar Fill="{Binding ScoreFill}" Present="{Binding HasScore}" Margin="8,0,0,0" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="UsualCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding UsualText}" Secondary="True" Absent="{Binding NoUsual}"
                                   ToolTip="{Binding UsualTooltip}" />
            </DataTemplate>

            <DataTemplate x:Key="TimedCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding TimedText}" />
            </DataTemplate>

            <DataTemplate x:Key="PartsCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfPartsBars Parts="{Binding Parts}" Loc="{Binding DataContext.Loc, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Left" />
            </DataTemplate>

            <DataTemplate x:Key="ThroughputCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding Cells[0].Text}" Absent="{Binding Cells[0].Absent}"
                                   ToolTip="{Binding Cells[0].Tooltip}" />
            </DataTemplate>

            <DataTemplate x:Key="LatencyCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding Cells[1].Text}" Absent="{Binding Cells[1].Absent}"
                                   ToolTip="{Binding Cells[1].Tooltip}" />
            </DataTemplate>

            <DataTemplate x:Key="ReasoningCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding Cells[2].Text}" Absent="{Binding Cells[2].Absent}"
                                   ToolTip="{Binding Cells[2].Tooltip}" />
            </DataTemplate>

            <DataTemplate x:Key="PaceCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding Cells[3].Text}" Absent="{Binding Cells[3].Absent}"
                                   ToolTip="{Binding Cells[3].Tooltip}" />
            </DataTemplate>

            <DataTemplate x:Key="ToolTimeCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding Cells[4].Text}" Absent="{Binding Cells[4].Absent}"
                                   ToolTip="{Binding Cells[4].Tooltip}" />
            </DataTemplate>

            <DataTemplate x:Key="ToolSuccessCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding Cells[5].Text}" Absent="{Binding Cells[5].Absent}"
                                   ToolTip="{Binding Cells[5].Tooltip}" />
            </DataTemplate>

            <DataTemplate x:Key="CacheCell" DataType="{x:Type perf:PerfRowView}">
                <perf:PerfFadeText Style="{StaticResource NumberCell}" Text="{Binding Cells[6].Text}" Absent="{Binding Cells[6].Absent}"
                                   ToolTip="{Binding Cells[6].Tooltip}" />
            </DataTemplate>

            <!-- Narrow: a keyboard list of rows (no scroller of its own). -->
            <Style x:Key="ListStyle" TargetType="ListBox">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <history:SpringStackPanel ReduceMotion="{Binding (perf:PerfHistoryAppearance.ReduceMotion), RelativeSource={RelativeSource Self}}" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A list row: a hairline under it; hover, focus and selection show a soft chip. One element for screen readers. -->
            <Style x:Key="ListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="4,9,4,9" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource RoundedFocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="Transparent">
                                <Border x:Name="Chip" CornerRadius="4" Margin="0,1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Line 1: the dot, the id and, trailing, the score with its meter; line 2 the source, the timed requests and the usual
                 value; line 3 the present components as label value pairs. -->
            <DataTemplate x:Key="ListRow" DataType="{x:Type perf:PerfRowView}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <perf:PerfFadeText Text="{Binding ScoreText}" FontSize="{x:Static layout:PerfHistoryLayout.ScoreSize}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Absent="{Binding LowSample}" />
                            <perf:PerfMeterBar Fill="{Binding ScoreFill}" Present="{Binding HasScore}" Margin="8,0,0,0" />
                        </StackPanel>
                        <history:SourceDot DockPanel.Dock="Left" Colors="{Binding SourceColors}" Width="{x:Static layout:PerfHistoryLayout.SourceDot}"
                                           Height="{x:Static layout:PerfHistoryLayout.SourceDot}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <controls:ShrinkFirstPanel VerticalAlignment="Center">
                            <history:MiddleTrimmedText Style="{StaticResource ModelId}" FontWeight="SemiBold" />
                            <perf:PerfSampleChip Text="{Binding SampleLow}" ToolTip="{Binding ScoreTooltip}" Margin="7,0,0,0"
                                                 Visibility="{Binding LowSample, Converter={StaticResource Visible}}" />
                        </controls:ShrinkFirstPanel>
                    </DockPanel>
                    <perf:PerfFadeText Text="{Binding Line2}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="14,3,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <perf:PerfFadeText Text="{Binding PresentLine}" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="14,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <ListView x:Name="Table" Style="{StaticResource TableStyle}" ItemContainerStyle="{StaticResource TableRow}" ItemsSource="{Binding Rows}"
                  AutomationProperties.Name="{Binding Title}" Visibility="{Binding ShowsTable, Converter={StaticResource Visible}}">
            <ListView.View>
                <GridView x:Name="TableView" AllowsColumnReorder="False" />
            </ListView.View>
        </ListView>

        <ListBox x:Name="List" Style="{StaticResource ListStyle}" ItemContainerStyle="{StaticResource ListItem}" ItemTemplate="{StaticResource ListRow}"
                 ItemsSource="{Binding Rows}" AutomationProperties.Name="{Binding Title}"
                 Visibility="{Binding ShowsList, Converter={StaticResource Visible}}" />
    </StackPanel>
</UserControl>
