<UserControl x:Class="AgentSpeed.History.Perf.PerfPerformanceSection"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:perf="clr-namespace:AgentSpeed.History.Perf"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History.Perf;assembly=AgentSpeed.Presentation"
             Focusable="False" IsTabStop="False"
             perf:PerfHistoryAppearance.Dark="{Binding Dark}"
             perf:PerfHistoryAppearance.HighContrast="{Binding HighContrast}"
             perf:PerfHistoryAppearance.ReduceMotion="{Binding ReduceMotion}"
             perf:PerfHistoryAppearance.Generation="{Binding AppearanceGeneration}"
             AutomationProperties.Name="{Binding Title}">
    <!-- 性能表現 (DESIGN 12, Usage History: performance): its data context is the window's PerfHistoryViewModel; the window puts
         it in a card between Effort and speed and the daily table. A group named history.perf.title whose title is a heading. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentSpeed;component/History/Perf/PerfResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: the title and ⓘ. -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Title}" FontSize="{x:Static layout:PerfHistoryLayout.TitleSize}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
            <Button x:Name="InfoButton" Style="{DynamicResource SubtleButton}" MinWidth="24" Width="24" Height="24" Padding="0"
                    Margin="4,1,0,0" VerticalAlignment="Center" Click="OnInfo"
                    ToolTip="{Binding InfoLabel}" AutomationProperties.Name="{Binding InfoLabel}" AutomationProperties.HelpText="{Binding Info}">
                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource AppSymbolFontFamily}" FontSize="13" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </StackPanel>

        <!-- What the ⓘ opens: history.perf.info and every component's name with what it measures; Escape or a click elsewhere closes it. -->
        <Popup x:Name="InfoFlyout" PlacementTarget="{Binding ElementName=InfoButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" HorizontalOffset="-12" VerticalOffset="-8" Closed="OnInfoClosed" KeyDown="OnInfoKeyDown">
            <Border Margin="12" Width="{x:Static layout:PerfHistoryLayout.InfoWidth}" Padding="16,14,16,12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    TextElement.FontFamily="{DynamicResource AppFontFamily}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.2" />
                </Border.Effect>
                <ScrollViewer x:Name="InfoScroller" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" Focusable="True" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Title}">
                    <StackPanel>
                        <TextBlock Text="{Binding Info}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                        <Rectangle Style="{DynamicResource Hairline}" Margin="0,12,0,10" />
                        <ItemsControl ItemsSource="{Binding InfoTerms}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type perf:PerfInfoTerm}">
                                    <StackPanel Margin="0,0,0,9">
                                        <TextBlock Text="{Binding Term}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Hint}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <Grid x:Name="Body">
            <!-- Re-analysing: static placeholders in the track color where the chart and the rows will be. -->
            <StackPanel Visibility="{Binding ShowsAnalyzing, Converter={StaticResource Visible}}">
                <perf:PerfPlaceholderView ChartHeight="{Binding ChartHeight}" Margin="0,16,0,0" />
                <TextBlock x:Name="AnalyzingLine" Text="{Binding AnalyzingText}" FontSize="11.5" Margin="0,12,0,2" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <!-- No timed request in the range: the section stays, so the feature is discoverable. -->
            <StackPanel Visibility="{Binding ShowsEmpty, Converter={StaticResource Visible}}" Margin="12,22,12,10" HorizontalAlignment="Center">
                <controls:GaugeGlyph Width="30" Height="30" HorizontalAlignment="Center"
                                     TextElement.Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding EmptyText}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding EmptyHint}" FontSize="11.5" LineHeight="17" Margin="0,5,0,0" MaxWidth="380" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowsData, Converter={StaticResource Visible}}">
                <!-- The trend's title line and, trailing, its legend. -->
                <DockPanel Margin="0,12,0,6">
                    <StackPanel x:Name="Legend" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Rectangle Width="12" Height="1" VerticalAlignment="Center" Fill="{Binding ReferenceInk, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Text="{Binding ReferenceLegend}" FontSize="{x:Static layout:PerfHistoryLayout.LegendSize}" Margin="5,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding ShowsUsualLegend, Converter={StaticResource Visible}}">
                            <Line X1="0" X2="12" Y1="0.5" Y2="0.5" StrokeThickness="1" StrokeDashArray="4 3" VerticalAlignment="Center"
                                  Stroke="{Binding UsualInk, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding UsualLegend}" FontSize="{x:Static layout:PerfHistoryLayout.LegendSize}" Margin="5,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TrendTitle" FontSize="{x:Static layout:PerfHistoryLayout.TrendTitleSize}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <perf:PerfTrendChart x:Name="Chart" Height="{Binding ChartHeight}" />
                <perf:PerfTableView Margin="0,12,0,0" />
                <TextBlock Text="{Binding Footnote}" FontSize="{x:Static layout:PerfHistoryLayout.FootnoteSize}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
