<Window x:Class="AgentSpeed.Controls.NoticeDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleText}" FontSize="18" TextWrapping="Wrap" LineHeight="24"
                       AutomationProperties.HeadingLevel="Level1" />
            <!-- The detail, such as the picked path: selectable so it can be copied. -->
            <TextBox x:Name="Detail" Style="{StaticResource SelectableText}" FontSize="13" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Command area, as in a WinUI content dialog: one button that confirms and closes. -->
        <Border Grid.Row="1" Padding="24" BorderThickness="0,1,0,0"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OkButton" Grid.Column="2" Height="32" HorizontalAlignment="Stretch" FontSize="14"
                        Style="{DynamicResource AccentButtonStyle}" IsDefault="True" IsCancel="True" Click="OnOk" />
            </Grid>
        </Border>
    </Grid>
</Window>
