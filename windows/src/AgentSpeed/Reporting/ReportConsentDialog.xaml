<Window x:Class="AgentSpeed.Reporting.ReportConsentDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AgentSpeed.Localization"
        xmlns:controls="clr-namespace:AgentSpeed.Controls"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Title="{Binding Title}"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.Name="{Binding Title}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <controls:TextToVisibilityConverter x:Key="HasText" />
        <controls:EnabledOpacityConverter x:Key="EnabledOpacity" />
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,20,24,20">
                <!-- Title and what happens -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:AccentBadge Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEC05;" FontSize="15" Foreground="White" />
                    </controls:AccentBadge>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                </Grid>
                <TextBlock Text="{Binding Body}" Style="{StaticResource BodyText}" FontSize="13" LineHeight="20" Margin="0,12,0,0" />

                <!-- The service card -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Host, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="-2,2,0,0" AutomationProperties.Name="{Binding Host}" />
                        <TextBox Text="{Binding ServiceHost, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="-2,0,0,0"
                                 Visibility="{Binding ServiceHost, Converter={StaticResource HasText}}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Footnote}" Margin="0,6,0,0" MaxHeight="51" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Description, Converter={StaticResource HasText}}" />
                        <TextBlock Text="{Binding Retention}" Style="{StaticResource Footnote}" Margin="0,4,0,0"
                                   Visibility="{Binding Retention, Converter={StaticResource HasText}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsLoopback, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{loc:Loc report.url.loopback}" Style="{StaticResource Footnote}" Margin="6,0,0,0" />
                        </StackPanel>
                        <WrapPanel Margin="-4,6,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.service.terms}" Command="{Binding TermsCommand}" FontSize="13" />
                            <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.service.privacy}" Command="{Binding PrivacyCommand}" FontSize="13" Margin="8,0,0,0" />
                            <Button Style="{StaticResource LinkButton}" Content="{loc:Loc report.service.leaderboard}" Command="{Binding LeaderboardCommand}" FontSize="13"
                                    Margin="8,0,0,0" Visibility="{Binding HasLeaderboard, Converter={StaticResource Visible}}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Username: the label, the field with the random-name button, then what it means -->
                <TextBlock Text="{loc:Loc report.username}" Style="{StaticResource BodyText}" FontSize="13" Margin="0,18,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                             AutomationProperties.Name="{loc:Loc report.username}" AutomationProperties.HelpText="{loc:Loc report.username.public}" />
                    <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Command="{Binding RandomCommand}" Margin="6,0,0,0"
                            ToolTip="{loc:Loc report.username.random}" AutomationProperties.Name="{loc:Loc report.username.random}">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE8B1;" FontSize="15" />
                    </Button>
                </Grid>
                <TextBlock Text="{loc:Loc report.username.public}" Style="{StaticResource Footnote}" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Visibility="{Binding UsernameError, Converter={StaticResource HasText}}">
                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEA39;" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{Binding UsernameError}" Style="{StaticResource Footnote}" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding OffersTransfer, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc report.username.transfer.hint}" Style="{StaticResource Footnote}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Content="{loc:Loc report.username.transfer}" Command="{Binding TransferCommand}" />
                    </Grid>
                </Border>

                <!-- API key, when the service uses keys -->
                <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowsApiKey, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc report.apiKey}" Style="{StaticResource BodyText}" FontSize="13" />
                            <TextBlock Text="{loc:Loc report.apiKey.required}" Style="{StaticResource Footnote}" Margin="0,2,0,0"
                                       Visibility="{Binding ApiKeyRequired, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <Grid Grid.Column="1" Width="254" VerticalAlignment="Center">
                            <PasswordBox x:Name="ApiKeyBox" MaxLength="256" PasswordChanged="OnApiKeyChanged" AutomationProperties.Name="{loc:Loc report.apiKey}" />
                            <TextBlock x:Name="ApiKeyPlaceholder" Text="{Binding ApiKeyPlaceholder}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" />
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"
                                Visibility="{Binding ApiKeyError, Converter={StaticResource HasText}}">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEA39;" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{Binding ApiKeyError}" Style="{StaticResource Footnote}" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc report.apiKey.hint}" Style="{StaticResource Footnote}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{loc:Loc report.apiKey.get}" Command="{Binding GetApiKeyCommand}"
                                Visibility="{Binding HasApiKeyUrl, Converter={StaticResource Visible}}" />
                    </Grid>
                </StackPanel>

                <!-- What's sent -->
                <TextBlock Text="{loc:Loc report.sections}" Style="{StaticResource BodyStrongText}" FontSize="13" Margin="0,18,0,2" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{loc:Loc report.sections.hint}" Style="{StaticResource Footnote}" Margin="0,0,0,6" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,0" MinHeight="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                                        <TextBlock Text="{Binding Title}" FontSize="13" Opacity="{Binding IsEnabled, Converter={StaticResource EnabledOpacity}}" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Footnote}" Visibility="{Binding Caption, Converter={StaticResource HasText}}" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Footnote}" Visibility="{Binding Hint, Converter={StaticResource HasText}}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                              AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding HelpText}" />
                                    <Rectangle Grid.ColumnSpan="2" Style="{StaticResource Hairline}" VerticalAlignment="Bottom" Margin="-14,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- The live preview of the exact body -->
                <Expander Margin="0,16,0,0" IsExpanded="True" AutomationProperties.Name="{loc:Loc report.preview.title}">
                    <Expander.Header>
                        <TextBlock Text="{loc:Loc report.preview.title}" FontSize="13" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Border x:Name="PreviewHost" MaxHeight="240" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc report.preview.hint}" Style="{StaticResource Footnote}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Click="OnCopy" AutomationProperties.Name="{loc:Loc report.preview.copy}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE8C8;" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc report.preview.copy}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>

                <TextBlock Text="{loc:Loc report.consent.never}" Style="{StaticResource Footnote}" FontSize="11" Margin="0,16,0,0" />
                <TextBlock Text="{loc:Loc report.consent.honesty}" Style="{StaticResource Footnote}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Command area, as in a WinUI content dialog: the primary action on the left and default, Cancel on the right -->
        <Border Grid.Row="1" Padding="24,16,24,20" BorderThickness="0,1,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding Failure, Converter={StaticResource HasText}}">
                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{Binding Failure}" Style="{StaticResource Footnote}" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsStarting, Converter={StaticResource Visible}}">
                    <controls:ProgressRing Width="14" Height="14" Thickness="2" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{loc:Loc report.status.registering}" Style="{StaticResource Footnote}" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Grid.Column="0" Height="32" FontSize="14" HorizontalAlignment="Stretch" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" Content="{loc:Loc report.start}" Command="{Binding StartCommand}" />
                    <Button x:Name="CancelButton" Grid.Column="2" Height="32" FontSize="14" HorizontalAlignment="Stretch" IsCancel="True"
                            Content="{loc:Loc history.cancel}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
