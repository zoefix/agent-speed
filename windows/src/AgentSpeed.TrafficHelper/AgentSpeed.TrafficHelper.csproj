<Project Sdk="Microsoft.NET.Sdk">
  <!-- WINDOWS-SERVICE 2: the traffic helper service and its elevated install/remove verbs. One NativeAOT file, no
       runtime, no side-by-side DLLs; publish with `dotnet publish -c Release -r win-x64` (or win-arm64). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AgentSpeedTrafficHelper</AssemblyName>
    <RootNamespace>AgentSpeed.TrafficHelper</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The helper's own version (HelperProtocol.BundledVersion), independent of the app's. -->
    <Version>1.0.0</Version>
    <Description>Agent Speed Traffic Helper</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NativeAOT only when publishing for a Windows RID; a plain build (macOS, tests) stays an ordinary JIT assembly. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <NullabilityInfoContextSupport>false</NullabilityInfoContextSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <!-- Static imports resolve from System32 only (WINDOWS-SERVICE 3.1, 7). -->
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
    <!-- Reproducible link (no time stamp), so identical sources give the same embedded SHA-256. -->
    <LinkerArg Include="/Brepro" />
    <DirectPInvoke Include="kernel32" />
    <DirectPInvoke Include="advapi32" />
    <DirectPInvoke Include="tdh" />
    <DirectPInvoke Include="ntdll" />
    <DirectPInvoke Include="bcrypt" />
    <NativeLibrary Include="tdh.lib" />
    <NativeLibrary Include="ntdll.lib" />
    <NativeLibrary Include="bcrypt.lib" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\shared\src\AgentSpeed.Core\Traffic\Helper\HelperProtocol.cs" Link="Protocol\HelperProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentSpeed.TrafficHelper.Tests" />
  </ItemGroup>
</Project>
